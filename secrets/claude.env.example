# mvpgen이 Claude를 호출할 때 쓰는 인증 정보.
# 이 파일을 claude.env로 복사해 아래 방법 중 하나만 채운다. 셸에 이미 export된 값이 있으면 그 값이 우선한다.
# 값이 빈 줄은 무시된다 (빈 값을 export하면 우선순위를 차지해 인증이 실패하므로 일부러 빼 둔다).

# 방법 0. 구독(Pro, Max) 로그인: 이 파일을 비워 두고 터미널에서 claude를 실행해 /login 한다.
# 아래 값이 하나라도 채워져 있으면 그쪽이 우선한다.

# 방법 1. API 키 (https://platform.claude.com/ 에서 발급)
ANTHROPIC_API_KEY=

# 방법 1-1. 구독 토큰 (claude setup-token으로 발급, 1년 유효). 브라우저 로그인이 안 되는 CI용
# 비용은 구독 한도에서 나간다. ANTHROPIC_API_KEY가 채워져 있으면 키가 우선한다.
# CLAUDE_CODE_OAUTH_TOKEN=

# 방법 2. Workload Identity Federation (API 키 없음)
# 방법 1의 ANTHROPIC_API_KEY가 채워져 있으면 그쪽이 우선하므로 비워 둔다.
# ID는 비밀값이 아니다. Console > Settings > Workload identity, Settings > Organization에서 확인한다.
# ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
# ANTHROPIC_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# ANTHROPIC_SERVICE_ACCOUNT_ID=svac_...
# ANTHROPIC_WORKSPACE_ID=wrkspc_...     # 규칙이 여러 워크스페이스에 걸쳐 있을 때만 필요
# ANTHROPIC_IDENTITY_TOKEN_FILE=/path/to/jwt
#   ID 토큰(JWT)은 IdP가 발급해 이 파일에 계속 새로 써 줘야 한다.
#   GitHub Actions에서는 mvpgen이 자동으로 받아 1분마다 갱신하므로 이 줄을 쓰지 않는다.

# 방법 3. 클라우드 제공자
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_VERTEX=1
# CLAUDE_CODE_USE_FOUNDRY=1
